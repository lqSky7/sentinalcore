# Sentinal Analysis Engine Configuration
# Copy this file to .env and fill in your API keys

# Gemini AI API Key (for dynamic analysis)
GEMINI_API_KEY=your_gemini_api_key_here

# VirusTotal API Key (for static analysis hash lookups)
VIRUSTOTAL_API_KEY=your_virustotal_api_key_here

# Example:
# GEMINI_API_KEY=AIzaSyA1B2C3D4E5F6G7H8I9J0K1L2M3N4O5P6Q
# VIRUSTOTAL_API_KEY=1234567890abcdef1234567890abcdef12345678901234567890abcdef1234567